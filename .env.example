# Copy to .env (git-ignored) and adjust. docker compose reads this file automatically.

# Comma-separated list of accepted API keys (min 16 chars each). Several keys allow zero-downtime rotation.
API_KEYS=local-dev-api-key-change-me

# Host ports published by docker compose (change them if already in use on your machine).
APP_PORT=8080
MANAGEMENT_PORT=8081
DB_PORT=5432

# Database credentials used by both the postgres and app containers.
DB_NAME=candidates
DB_USERNAME=candidates
DB_PASSWORD=candidates
